cat > .env.example << 'EOF'
# HenPlanner — Environment variables example

# This app does not currently require any environment variables at runtime.
# The weather integration uses Open-Meteo (https://open-meteo.com), which does not require an API key — this is why no secrets are committed.

# If future features require API keys (e.g. push notifications via a third
# party, analytics, crash reporting), they will be added here.

EOF